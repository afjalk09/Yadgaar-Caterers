# Public, non-secret values. Safe to include in the client bundle.
# Canonical production origin (no trailing slash). Defaults to this domain if omitted.
NEXT_PUBLIC_SITE_URL=https://yadgaarcaterers.cc.cd

# Google Tag Manager container ID (public by design). The provided container is used by default.
# Set to an empty value only if you want the direct GA4 loader below to be used instead.
NEXT_PUBLIC_GTM_ID=GTM-T68P9QZR

# Fallback Google Analytics 4 measurement ID (public by design). Used only when GTM_ID is empty.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-PLACEHOLDER

# Cloudflare Turnstile site key (public by design). Leave blank to keep the honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Comma-separated origins allowed to access the Next.js dev server (e.g. a preview proxy domain).
NEXT_DEV_ORIGINS=

# Server-side only. Never prefix with NEXT_PUBLIC_. Leave blank to skip Turnstile verification.
TURNSTILE_SECRET_KEY=

# Port used by npm run dev / npm run start.
PORT=3000
